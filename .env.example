# Copy this file to .env and fill in real values before running the app.
# .env is gitignored — .env.example is committed, so keep only placeholders
# here, never real credentials.

# Any long random string. Used to sign Payload's auth tokens.
PAYLOAD_SECRET=

# Postgres connection string for the Payload database (e.g. a Supabase
# connection pooler URL).
#
# Prefer the TRANSACTION-mode pooler (Supabase port 6543) over session mode
# (5432) in production: session mode holds one server connection per client
# for its whole life and caps out around pool_size 15, which a handful of
# serverless instances will exhaust. Transaction mode hands the connection
# back after each statement and takes far more clients.
DATABASE_URI=postgresql://user:password@host:6543/database

# Max Postgres connections per running instance (serverless function, build
# worker, dev server). Defaults to 3. Instances × this must stay under the
# database's client limit — see the comment in src/payload.config.ts.
DATABASE_POOL_MAX=3

# --- Cloudflare R2 (S3-compatible) media storage -----------------------------

S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# The R2 bucket name.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

NEXT_PUBLIC_S3_PUBLIC_URL=

# --- Resend ("Book a call" form) -------------------------------------------
# Server-side only: the key never reaches the browser, so there is no origin
# allowlist to maintain. Create one at resend.com/api-keys with "Sending
# access" — a full-access key is not needed.
RESEND_API_KEY=re_...

# Where callback requests land. Defaults to gmsturbogeorgia@gmail.com.
BOOKING_TO_EMAIL=gmsturbogeorgia@gmail.com

# The From address. Must be on a domain verified at resend.com/domains —
# an unverified domain is rejected. Until gmsturbo.ge is verified, leave this
# blank: it falls back to onboarding@resend.dev, which Resend allows but which
# can only deliver to the address that owns the Resend account.
BOOKING_FROM_EMAIL=GMS Turbo <bookings@gmsturbo.ge>
